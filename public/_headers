# Cache-control rules read by Cloudflare Pages.

# Fonts: safe to cache hard, they never change without a new filename.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS/JS use stable filenames, so browsers must revalidate on page reload -
# otherwise a redeploy can mix new HTML with an old cached stylesheet.
/assets/css/*
  Cache-Control: no-cache
/assets/js/*
  Cache-Control: no-cache

# HTML entry points: never cache, so a redeploy is always visible.
/index.html
  Cache-Control: no-cache
